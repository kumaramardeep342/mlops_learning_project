# Stage 1: Base image with dependencies using uv
FROM python:3.12-slim AS base

# Install uv binary from official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY pyproject.toml .
# RUN uv pip install --system .[train]
# Install CPU-only PyTorch index to skip heavy CUDA wheel downloads
RUN uv pip install --system --extra-index-url https://download.pytorch.org/whl/cpu .[train]

# Stage 2: Training runtime
FROM base AS training

WORKDIR /app

COPY src/ ./src/
COPY configs/ ./configs/

ENTRYPOINT ["python", "src/training/train.py"]